{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-4",

  "autoupdate": false,

  "share": "manual",
  "autoshare": false,

  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "bunx",
        "@modelcontextprotocol/server-sequential-thinking@latest"
      ],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["bunx", "@playwright/mcp@latest"],
      "enabled": false
    },
    "duckduckgo": {
      "type": "local",
      "command": ["uvx", "duckduckgo-mcp-server"],
      "enabled": false
    },
    "effect": {
      "type": "local",
      "command": ["bunx", "effect-mcp@latest"],
      "enabled": false
    }
  }
}
