{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-4",
  "small_model": "github-copilot/gpt-5-mini",

  "share": "manual",
  "autoshare": false,

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/sse",
      "enabled": false
    },
    "effect": {
      "type": "local",
      "command": ["bunx", "effect-mcp@latest"],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "docker",
        "container",
        "run",
        "-i",
        "--rm",
        "--init",
        "--network",
        "host",
        "mcr.microsoft.com/playwright/mcp"
      ],
      "enabled": false
    }
  }
}
