{
  "$schema": "https://opencode.ai/config.json",

  // "model": "gemini-cli/gemini-3-pro-preview",
  // "model": "gemini-cli/gemini-3-flash-preview",
  // "model": "minimax-coding-plan/MiniMax-M2.1",
  // "model": "opencode/kimi-k2.5-free",
  "model": "kimi-for-coding/k2p5",
  "small_model": "google/gemini-2.5-flash-lite",

  "permission": {
    "external_directory": {
      "/home/*/dotfiles/*": "allow",
      "/home/*/.config/*": "allow",
    },
  },

  "agent": {
    "plan": {
      "permission": {
        "edit": {
          "*plan.md": "allow",
        },
      },
    },
    "general": {
      "model": "opencode/minimax-m2.5-free",
      "disable": true,
    },
    "explore": {
      "model": "opencode/minimax-m2.5-free",
    },
    "review": {
      "model": "kimi-for-coding/k2p5",
    },
    "compaction": {
      "model": "opencode/minimax-m2.5-free",
    },
  },

  "mcp": {
    "documentation": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
      "enabled": true,
    },
    "github_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
    },
  },

  "provider": {
    "modal": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Modal",
      "options": {
        "baseURL": "https://api.us-west-2.modal.direct/v1",
        "apiKey": "{env:MODAL_API_KEY}",
      },
      "models": {
        "zai-org/GLM-5-FP8": {
          "name": "GLM-5",
        },
      },
    },
  },

  "keybinds": {
    "terminal_suspend": "none",
  },
}
