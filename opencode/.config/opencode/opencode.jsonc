{
  "$schema": "https://opencode.ai/config.json",

  "model": "minimax-coding-plan/MiniMax-M2.1",
  "small_model": "opencode/grok-code",

  "permission": {
    "external_directory": {
      "/home/*/dotfiles/*": "allow",
      "/home/*/.config/*": "allow",
    },
  },

  "agent": {
    "plan": {
      "permission": {
        "edit": {
          "*plan.md": "allow",
        },
      },
    },
    "general": {
      "model": "minimax-coding-plan/MiniMax-M2.1",
    },
    "explore": {
      "model": "minimax-coding-plan/MiniMax-M2.1",
    },
  },

  "plugin": ["opencode-google-auth@latest"],
  "mcp": {
    "documentation": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
      "enabled": true,
    },
    "github_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
    },
    "browser": {
      "type": "local",
      "command": ["bunx", "playwriter"],
      "enabled": false,
    },
    "minimax_utils": {
      "type": "local",
      "command": ["uvx", "minimax-coding-plan-mcp", "-y"],
      "environment": {
        "MINIMAX_API_KEY": "{env:MINIMAX_API_KEY}",
        "MINIMAX_API_HOST": "https://api.minimax.io",
      },
      "enabled": false,
    },
  },

  "disabled_providers": ["minimax-cn"],

  "keybinds": {
    "terminal_suspend": "none",
  },

  // "model": "gemini-cli/gemini-3-pro-preview",
  // "model": "gemini-cli/gemini-3-flash-preview",

  // "model": "opencode/glm-4.7-free",
  // "model": "opencode/big-pickle",
}
