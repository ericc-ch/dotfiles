{
  "$schema": "https://opencode.ai/config.json",

  // "model": "gemini-cli/gemini-3-pro-preview",
  // "model": "gemini-cli/gemini-3-flash-preview",
  "model": "minimax-coding-plan/MiniMax-M2.1",
  "small_model": "opencode/grok-code",

  "permission": {
    "external_directory": {
      "/home/*/dotfiles/*": "allow",
      "/home/*/.config/*": "allow",
    },
  },

  "agent": {
    "plan": {
      "permission": {
        "edit": {
          "*plan.md": "allow",
        },
      },
    },
    "general": {
      "model": "minimax-coding-plan/MiniMax-M2.1",
      "disable": true,
    },
    "explore": {
      "model": "minimax-coding-plan/MiniMax-M2.1",
    },
    "review": {
      "model": "gemini-cli/gemini-3-pro-preview",
    },
  },

  "plugin": ["opencode-google-auth@latest"],
  "mcp": {
    "documentation": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
      "enabled": true,
    },
    "github_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
    },
  },

  "keybinds": {
    "terminal_suspend": "none",
  },
}
