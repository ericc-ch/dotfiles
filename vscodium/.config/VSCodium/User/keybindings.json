// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+shift+i",
        "command": "-codeium.openCodeiumCommand",
        "when": "codeium.commandEnabled && editorTextFocus && !inlineSuggestionsVisible"
    },
    {
        "key": "shift+alt+l",
        "command": "eslint.executeAutofix"
    },
    {
      "key": "ctrl+i",
      "command": "-codeium.openCodeiumCommand",
      "when": "codeium.commandEnabled && editorTextFocus && !inlineSuggestionsVisible"
    }
]