// spawn-at-startup "kitty" "+kitten" "panel" "bar"
spawn-at-startup "kitty" "--single-instance"
spawn-sh-at-startup "wbg ~/dotfiles/assets/debian.png"

environment {
    QT_QPA_PLATFORMTHEME "qt5ct"
}

overview {
    backdrop-color "#141617"
}

input {
    mouse {
        accel-profile "flat"
    }
}

layout {
    empty-workspace-above-first

    gaps 8

    border {
        width 2
        active-gradient from="#ebdbb2" to="#7c6f64"
        inactive-color "#3c3836"
    }

    insert-hint {
        color "#7c6f64"
    }

    focus-ring {
        off
    }

    struts {
        left 32
        right 32
    }
}

window-rule {
    clip-to-geometry true
    geometry-corner-radius 8
}

binds {
    // Applications
    Mod+T { spawn "kitty" "--single-instance"; }
    Mod+E { spawn "nautilus"; }
    Alt+Space { spawn "kitten" "panel" "--single-instance" "--edge" "center-sized" "--lines" "20" "--columns" "40" "--layer" "overlay" "--grab-keyboard" "--focus-policy" "on-demand" "launcher"; }

    // Audio
    XF86AudioRaiseVolume allow-when-locked=true { spawn "pamixer" "-u" "-i" "5"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "pamixer" "-u" "-d" "5"; }
    XF86AudioMute        allow-when-locked=true { spawn "pamixer" "-t"; }

    // Overview
    Mod+Tab { toggle-overview; }

    // Window management
    Mod+F4 repeat=false { close-window; }
    Alt+F4 repeat=false { close-window; }

    // Focus: WASD navigation
    Mod+W { focus-window-or-workspace-up; }
    Mod+A { focus-column-left; }
    Mod+S { focus-window-or-workspace-down; }
    Mod+D { focus-column-right; }

    // Move: Ctrl + WASD
    Mod+Shift+W { move-window-up; }
    Mod+Shift+A { move-column-left; }
    Mod+Shift+S { move-window-down; }
    Mod+Shift+D { move-column-right; }

    // Column stacks: ZXC
    Mod+Z { consume-or-expel-window-left; }
    Mod+X { expel-window-from-column; }
    Mod+C { consume-or-expel-window-right; }

    // Move window to workspace (Ctrl+Shift)
    Mod+Ctrl+Shift+W { move-window-to-workspace-up; }
    Mod+Ctrl+Shift+S { move-window-to-workspace-down; }

    // Column/Window maximization
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // Screenshots
    Print { screenshot; }
    Mod+Print { screenshot-screen; }

    // Keyboard shortcuts inhibitor escape hatch
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}

hotkey-overlay {
    skip-at-startup
}
